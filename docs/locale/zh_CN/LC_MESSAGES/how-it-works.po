msgid "``/`` and static files"
msgstr "``/`` 与静态文件"

#: ../../how-it-works.rst:59
msgid "The frontend, served from ``web/``"
msgstr "前端，从 ``web/`` 提供"

#: ../../how-it-works.rst:60
