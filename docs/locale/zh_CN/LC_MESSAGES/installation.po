msgstr "改用系统浏览器打开，而不是原生窗口"

#: ../../installation.rst:77
msgid "``--no-browser``"
msgstr "``--no-browser``"

#: ../../installation.rst:78
msgid "Headless: serve the API only"
msgstr "无界面模式：只提供 API 服务"

#: ../../installation.rst:79
msgid "``--debug``"
msgstr "``--debug``"

