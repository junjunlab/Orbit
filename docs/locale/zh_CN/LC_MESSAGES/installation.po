msgstr "含义"

#: ../../installation.rst:69
msgid "``--data PATH``"
msgstr "``--data PATH``"

#: ../../installation.rst:70
msgid "Use another data directory instead of the bundled one"
msgstr "改用其他数据目录，而不是随包附带的那一份"

#: ../../installation.rst:71
msgid "``--port N``"
msgstr "``--port N``"

#: ../../installation.rst:72
msgid "Listen on a different port (default ``8765``)"
msgstr "监听其他端口（默认 ``8765``）"

#: ../../installation.rst:73
msgid "``--host HOST``"
msgstr "``--host HOST``"

#: ../../installation.rst:74
msgid "Bind address (default ``127.0.0.1``)"
msgstr "绑定地址（默认 ``127.0.0.1``）"

#: ../../installation.rst:75
msgid "``--browser``"
msgstr "``--browser``"

